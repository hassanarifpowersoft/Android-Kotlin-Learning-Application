            android:name=".FirebaseDatabaseSignUpActivity"
            android:exported="false" />
        <activity
            android:name=".FirebaseDatabaseLoginActivity"
            android:exported="false" />
        <activity
            android:name=".DataReceivedExampleActivity"
            android:exported="false" />
        <activity
            android:name=".DataTransferExampleActivity"
            android:exported="false" />
        <activity
            android:name=".WebViewActivity"
            android:exported="false" />
        <activity
